<Window x:Class="LogiDynamicDash.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogiDynamicDash Configurator"
        Width="1080"
        Height="760"
        MinWidth="900"
        MinHeight="650"
        Background="#0B0E12"
        Foreground="#F2F5F7"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F5F7" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,12" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#171C23" />
            <Setter Property="Foreground" Value="#DCE7ED" />
            <Setter Property="BorderBrush" Value="#344552" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 5 5 L 10 0"
                                                      Stroke="#8EDDEA"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#171C23"
                                        BorderBrush="#344552"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#171C23" />
            <Setter Property="Foreground" Value="#DCE7ED" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#164A59" />
                                <Setter Property="Foreground"
                                        Value="#5DEBFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#167C95" />
                                <Setter Property="Foreground"
                                        Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE7ED" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,12" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#171C23" />
            <Setter Property="Foreground" Value="#F2F5F7" />
            <Setter Property="BorderBrush" Value="#303946" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="#167C95" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#29313A" />
                                <Setter Property="Foreground"
                                        Value="#70808D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#12171D" />
            <Setter Property="BorderBrush" Value="#26303A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="22" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="LOGI"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="DYNAMIC"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#5DEBFF" />
                <TextBlock Text="DASH"
                           FontSize="28"
                           FontWeight="Bold" />
            </StackPanel>
            <TextBlock Text="RS50 OLED dashboard"
                       Foreground="#8EA0B2"
                       FontSize="14" />
            <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="RuntimeStateText"
                                   Text="Dashboard stopped"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="RuntimeDetailText"
                                   Text="OLED: stopped · iRacing: waiting · Car: unknown"
                                   Foreground="#9DB0C2"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="StartDashboardButton"
                                Content="Start dashboard"
                                Background="#18A57A"
                                Click="StartDashboard_Click" />
                        <Button x:Name="StopDashboardButton"
                                Content="Stop"
                                Background="#A33B3B"
                                IsEnabled="False"
                                Click="StopDashboard_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Profile"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14" />
                        <TextBlock Text="Official iRacing category" />
                        <ComboBox x:Name="DisciplineBox" />
                        <TextBlock Text="Speed unit" />
                        <ComboBox x:Name="SpeedUnitBox" />
                        <TextBlock Text="Maximum RPM" />
                        <TextBox x:Name="MaximumRpmBox" />
                        <TextBlock Text="Gauge maximum speed" />
                        <TextBox x:Name="GaugeSpeedBox" />
                        <CheckBox x:Name="AutomaticProfilesBox"
                                  Content="Automatically select profile from car and category"
                                  IsChecked="True"
                                  Margin="0,4,0,12" />
                        <TextBlock Text="Last-lap display duration (seconds)" />
                        <TextBox x:Name="LastLapSecondsBox"
                                 Text="5" />
                        <Button x:Name="ApplyRecommendationButton"
                                Content="Apply recommended profile"
                                HorizontalAlignment="Left"
                                Click="ApplyRecommendation_Click" />
                        <TextBlock x:Name="RecommendationText"
                                   Margin="0,14,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#9DB0C2" />
                        <Separator Margin="0,20,0,18"
                                   Background="#303946" />
                        <TextBlock Text="Detected session"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Inspect a schema 2 telemetry replay without opening HID."
                                   Margin="0,5,0,10"
                                   TextWrapping="Wrap"
                                   Foreground="#9DB0C2" />
                        <Button Content="Inspect telemetry replay"
                                HorizontalAlignment="Left"
                                Click="InspectReplay_Click" />
                        <TextBlock x:Name="DetectedIdentityText"
                                   Margin="0,12,0,10"
                                   Text="No session identity loaded."
                                   TextWrapping="Wrap"
                                   Foreground="#A7F3D0" />
                        <Button x:Name="ApplyDetectedButton"
                                Content="Apply detected recommendation"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                Click="ApplyDetected_Click" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button Content="Save for category"
                                    Background="#303946"
                                    Click="SaveCategoryProfile_Click" />
                            <Button x:Name="SaveCarProfileButton"
                                    Content="Save for this car (Pro preview)"
                                    IsEnabled="False"
                                    Click="SaveCarProfile_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Layouts by display mode"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Normal driving" />
                                <ComboBox x:Name="NormalLayoutBox" />
                                <TextBlock Text="Brake bias" />
                                <ComboBox x:Name="BrakeBiasLayoutBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Last lap" />
                                <ComboBox x:Name="LastLapLayoutBox" />
                                <TextBlock Text="Connection problem" />
                                <ComboBox x:Name="ConnectionLayoutBox" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OLED preview"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="PreviewModeBox"
                                      Grid.Column="1"
                                      Margin="0"
                                      Padding="8,5" />
                        </Grid>
                        <Border Background="#050708"
                                BorderBrush="#394550"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18"
                                Height="180">
                            <Grid x:Name="OledPreviewSurface" />
                        </Border>
                        <Expander Header="Protocol details"
                                  Foreground="#8EA0B2"
                                  Margin="0,10,0,0">
                            <Border Background="#0B1116"
                                    BorderBrush="#263945"
                                    BorderThickness="1"
                                    Padding="10"
                                    Margin="0,6,0,0">
                                <TextBlock x:Name="PreviewText"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="#8EDDEA"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Expander>
                        <TextBlock Text="HID access occurs only while the dashboard is explicitly running."
                                   Foreground="#F6C85F"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#9DB0C2"
                       Text="Ready." />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Open configuration"
                        Background="#303946"
                        Click="Open_Click" />
                <Button Content="Save configuration"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
