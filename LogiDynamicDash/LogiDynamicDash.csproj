<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SVappsLAB.iRacingTelemetrySDK" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LogiDynamicDash.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="..\artifacts\native\$(Configuration)\Rs50DirectInputBridge.dll"
      Link="Rs50DirectInputBridge.dll"
      CopyToOutputDirectory="PreserveNewest"
      Condition="Exists('..\artifacts\native\$(Configuration)\Rs50DirectInputBridge.dll')" />
  </ItemGroup>

</Project>
